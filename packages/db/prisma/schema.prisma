generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  FOLLOWUP
  EVALUATING
  DONE
  FAILED
}

enum MessageRole {
  USER
  AGENT
  SYSTEM
  REASONING
}

// ─── Auth models (better-auth required schema) ────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isAdmin       Boolean  @default(false)

  apiKeys           UserApiKey[]
  submissions       Submission[]
  sessions          Session[]
  accounts          Account[]
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  postVotes         CommunityPostVote[]
  commentVotes      CommunityCommentVote[]
  communityReports  CommunityReport[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── API key management ───────────────────────────────────────────────────────

model UserApiKey {
  id           String    @id @default(cuid())
  userId       String? // null = anonymous session key
  sessionId    String? // for anonymous users
  provider     String // "mistral"
  encryptedKey String
  iv           String
  keyHint      String // last 4 chars shown to user
  baseUrl      String? // optional custom API base URL (e.g. OpenRouter, Azure)
  validatedAt  DateTime?
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

// ─── Interview content ────────────────────────────────────────────────────────

model Question {
  id                String     @id @default(cuid())
  title             String
  prompt            String     @db.Text
  difficulty        Difficulty
  category          String
  estimatedMins     Int        @default(30)
  hints             Json // string[]
  coverageChecklist Json // string[]
  rubric            Json // RubricConfig
  referenceSolution String?    @db.Text
  isPublished       Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  submissions    Submission[]
  communityPosts CommunityPost[]
}

model Submission {
  id             String           @id @default(cuid())
  questionId     String
  userId         String?
  sessionId      String?
  lexicalState   Json // Lexical editor JSON
  excalidrawData Json? // Excalidraw elements JSON
  status         SubmissionStatus @default(PENDING)
  jobId          String?
  agentJobId     String?
  createdAt      DateTime         @default(now())

  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  result        EvalResult?
  messages      AgentMessage[]
  communityPost CommunityPost?

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model AgentMessage {
  id           String      @id @default(cuid())
  submissionId String
  sequence     Int?
  role         MessageRole
  content      String      @db.Text
  metadata     Json? // { type: "followup" | "reasoning" | "evaluation_progress" }
  createdAt    DateTime    @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, sequence])
}

model EvalResult {
  id              String   @id @default(cuid())
  submissionId    String   @unique
  modelName       String?
  overallScore    Float
  componentScores Json // Record<string, ComponentScore>
  feedback        String   @db.Text
  improvements    Json // string[]
  agentSatisfied  Boolean  @default(false)
  followupRounds  Int      @default(0)
  createdAt       DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

enum CommunityReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

model CommunityPost {
  id                String   @id @default(cuid())
  submissionId      String   @unique
  authorId          String
  questionId        String
  title             String
  answerText        String   @db.Text
  diagram           Json?
  includeEvaluation Boolean  @default(false)
  evaluation        Json?
  isHidden          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  submission Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question   Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  comments   CommunityComment[]
  votes      CommunityPostVote[]
  reports    CommunityReport[]

  @@index([createdAt])
  @@index([questionId, createdAt])
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String   @db.Text
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    CommunityPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes   CommunityCommentVote[]
  reports CommunityReport[]

  @@index([postId, createdAt])
}

model CommunityPostVote {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model CommunityCommentVote {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

model CommunityReport {
  id           String                @id @default(cuid())
  reporterId   String
  postId       String?
  commentId    String?
  reason       String
  details      String?               @db.Text
  status       CommunityReportStatus @default(OPEN)
  resolvedById String?
  createdAt    DateTime              @default(now())
  resolvedAt   DateTime?

  reporter User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post     CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
