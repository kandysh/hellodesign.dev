# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sysdesign

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# ─── Encryption (for API key storage) ────────────────────────────────────────
# Keep this separate from BETTER_AUTH_SECRET. Use at least 32 random characters.
ENCRYPTION_KEY=replace-with-a-different-random-key-at-least-32-characters
ENCRYPTION_KEY_VERSION=v1
# For key rotation, add ENCRYPTION_KEY_V2 and set ENCRYPTION_KEY_VERSION=v2.
# Keep the previous version configured until all ciphertexts have been re-encrypted.
ENCRYPTION_KEY_V2=

# ─── OAuth (optional) ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── App URLs ─────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Number of trusted reverse-proxy hops in front of the API. Set to 0 for direct
# local Node/Vite development; Compose routes through one nginx proxy by default.
TRUST_PROXY_HOPS=1
DEEP_EVAL_CONCURRENCY=2

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Leave blank to send API and auth requests through the same-origin proxy.
# Local Vite development proxies /api to localhost:3001.
VITE_API_URL=
